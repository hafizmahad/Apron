{
  "name": "apron-production",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start:standalone": "node --env-file-if-exists=.env .next/standalone/server.js",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx/esm src/jobs/worker.ts",
    "worker:prod": "node --env-file-if-exists=.env dist-worker/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:contracts": "vitest run --project contracts",
    "test:evals": "vitest run --project evals",
    "test:all": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --import tsx/esm src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx/esm src/db/seed/index.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx/esm src/db/reset.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx/esm scripts/smoke.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "build:all": "npm run build && npm run build:worker",
    "verify:rbac": "node --env-file-if-exists=.env --import tsx/esm scripts/verify-rbac.ts",
    "verify:routing": "node --env-file-if-exists=.env --import tsx/esm scripts/verify-routing.ts",
    "db:scenarios": "node --env-file-if-exists=.env --import tsx/esm scripts/seed-scenarios.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "argon2": "^0.45.1",
    "bullmq": "^5.44.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.5.0",
    "lucide-react": "^0.475.0",
    "luxon": "^3.5.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "openai": "^4.85.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.3.5",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  }
}
