# ---------------------------------------------------------------------------
# Apron Production — environment
#
# Copy to `.env` for local development. Every variable is validated at startup by
# `src/lib/config/env.ts`; the process refuses to boot with an invalid configuration.
# No secret has a default. Nothing here belongs in version control except this template.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
PORT=3000

# --- PostgreSQL ------------------------------------------------------------
# Docker Compose: host `postgres`. Running the app on the host against Compose: localhost.
DATABASE_URL=postgres://apron:apron_local_dev@localhost:55432/apron
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:56379

# --- sessions & passwords --------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_COOKIE_NAME=apron_session
SESSION_TTL_HOURS=12
PASSWORD_HASH_ALGO=argon2id

# --- OpenAI ----------------------------------------------------------------
# AI_ENABLED defaults to false. With it false the product is fully usable: intake falls
# back to the manual structured form and matching uses the deterministic top-ranked
# eligible candidate (CLAUDE.md §22). When set true, the key and ALL four model names
# become required and the process will refuse to start without them.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_SUMMARY_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_ATTEMPTS=2
# Prompt/response bodies may contain client and passenger data. Off by default.
# There are no token-accounting or cost variables: cost tracking is out of scope (ADR-015).
AI_STORE_PROMPT_BODIES=false

# --- mail ------------------------------------------------------------------
# `log` writes to the structured log, `memory` keeps messages for tests, `smtp` sends.
# Docker Compose runs Mailpit at http://localhost:58025 for local capture.
MAIL_TRANSPORT=log
MAIL_FROM=Apron Operations <ops@apron.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- SMS (optional, feature-flagged) ---------------------------------------
SMS_ENABLED=false
SMS_TRANSPORT=log

# --- documents -------------------------------------------------------------
DOCUMENT_STORAGE_DRIVER=filesystem
DOCUMENT_STORAGE_PATH=./.apron-storage
S3_BUCKET=
S3_REGION=

# --- maps (client-visible) -------------------------------------------------
# `static` projects real stored coordinates onto the packaged abstract map and needs no
# key. `maplibre` additionally requires a style URL. No coordinate is ever synthesised.
NEXT_PUBLIC_MAP_PROVIDER=static
NEXT_PUBLIC_MAP_STYLE_URL=

# --- observability ---------------------------------------------------------
LOG_LEVEL=info
# Human-readable logs. Applies to `npm run dev` and the tsx scripts ONLY — `pino-pretty` is
# a devDependency, so neither the standalone build nor the container has it, and both fall
# back to JSON with a warning. Leave false unless you are running the dev server.
LOG_PRETTY=false

# --- platform behaviour ----------------------------------------------------
RATE_LIMIT_ENABLED=true
QUEUE_ENABLED=true
WORKER_CONCURRENCY=4
